{
  "name": "zenith",
  "version": "1.0.0-beta.11",
  "description": "Another front-end framework.",
  "type": "module",
  "main": "dist/zenith.global.js",
  "module": "dist/zenith.js",
  "exports": {
    ".": "./dist/zenith.js",
    "./helpers": "./dist/zenith-helpers.js"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup --config && node scripts/after-build.mjs",
    "lint": "eslint . --ext .ts",
    "test": "vitest --run --coverage --reporter verbose",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleph1/zenith.git"
  },
  "author": "Daniel Barber / Aleph1",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aleph1/Zenith/issues"
  },
  "homepage": "https://github.com/aleph1/Zenith#readme",
  "devDependencies": {
    "@rollup/plugin-replace": "^4.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "brotli": "^1.3.3",
    "eslint": "^8.57.1",
    "jsdom": "^27.2.0",
    "rollup": "^2.74.1",
    "rollup-plugin-brotli": "^3.1.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
